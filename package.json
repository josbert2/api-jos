{
  "name": "api-jos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=!@josbert/ui",
    "dev:api": "pnpm --filter api dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:ui": "pnpm --filter ui dev",
    "dev:www": "pnpm --filter www dev",
    "dev:origin": "pnpm --filter origin dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed"
  },
  "devDependencies": {
    "turbo": "^2.6.1"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  }
}
